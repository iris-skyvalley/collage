{
  "name": "collage",
  "private": true,
  "version": "0.1.0",
  "description": "A mobile-web collage tool with a generated tray and AI manipulation verbs.",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "npm run assets",
    "assets": "node --experimental-strip-types tools/make-fragments.ts",
    "dev": "npm run assets && concurrently -n server,web -c cyan,magenta --kill-others-on-fail \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/src/index.ts",
    "dev:web": "npm -w web run dev",
    "build": "npm run assets && npm -w web run build",
    "start": "node --env-file-if-exists=.env server/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "predev": "node -e \"const f=require('fs');f.existsSync('.env')||f.copyFileSync('.env.example','.env')\""
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "concurrently": "^9.1.2",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
