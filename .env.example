# Copy to .env (npm run dev does this for you) and edit as needed.
# Every value here is the default; nothing in this file is required.

# Server port.
PORT=8787

# SQLite file. Use :memory: for a throwaway run.
DATABASE_FILE=data/collage.db

# Fragments per themed tray. The PRD targets 40-80.
TRAY_SIZE=60

# Set to 1 to add open-access archive items to the tray (PRD §8.2). Off by
# default: the tray must never depend on a third party being reachable.
ARCHIVE_ENABLED=0

# Set to production to stop the claim route returning its own sign-in link.
# NODE_ENV=production
